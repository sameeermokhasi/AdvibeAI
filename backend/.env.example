# Advibe Environment Configuration
PROJECT_NAME="Advibe API"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration (Docker Compose PostgreSQL / Supabase)
DATABASE_URL="postgresql://advibe_user:advibe_password@localhost:5432/advibe"

# Supabase Postgres Configuration (Optional / Managed)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-admin-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-min-32-chars-length"

# Groq LLM Configuration (Primary - Ultra-fast LPU inference)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenRouter LLM Configuration (Secondary Fallback - Multi-provider gateway)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"
OPENROUTER_MODEL="deepseek/deepseek-r1"

# Outreach (Resend Email API)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="Advibe <outreach@advibe.ai>"
RESEND_WEBHOOK_SECRET="whsec_123456789"

# Security & CORS
CORS_ORIGINS=["*"]
INTAKE_RATE_LIMIT="10/minute"
SEND_RATE_LIMIT="30/minute"
