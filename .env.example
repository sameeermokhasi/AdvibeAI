# PostgreSQL Configuration (Docker Compose)
POSTGRES_USER=advibe_user
POSTGRES_PASSWORD=advibe_password
POSTGRES_DB=advibe

# Database Connection URL (Standard SQLAlchemy / psycopg2 / asyncpg - Docker Compose port 5434)
DATABASE_URL=postgresql://advibe_user:advibe_password@localhost:5434/advibe

# JWT Secret for authentication tokens (min 32 chars)
SUPABASE_JWT_SECRET=advibe-local-dev-jwt-secret-key-min-32-chars

# Groq LLM Configuration (Primary - Ultra-fast LPU inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter LLM Configuration (Secondary Fallback - Multi-provider gateway)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL="deepseek/deepseek-r1"

# Outreach (Resend Email API)
RESEND_API_KEY=re_your_resend_api_key

# Backend Application Configuration
APP_ENV=development
ENVIRONMENT=development
PORT=8000
